// bot.js
// Basic CA tracker for ERC-20 style tokens on EVM chains

const { ethers } = require("ethers");
const { Telegraf } = require("telegraf");

// === EDIT THESE FOUR VALUES ===
const RPC_WS = "wss://your-rpc-url.here";        // from Alchemy/QuickNode
const TOKEN_CA = "0xYourTokenAddress".toLowerCase();
const TELEGRAM_TOKEN = "123456:ABCdefYourTokenHere";
const TELEGRAM_CHAT_ID = "123456789";            // your chat ID
// =================================

const provider = new ethers.providers.WebSocketProvider(RPC_WS);
const bot = new Telegraf(8453518694:AAF9a6R1mXVpcNRv-4EgDykmFOsw6fXG2vM);

const TRANSFER_TOPIC = ethers.id("Transfer(address,address,uint256)");
const SWAP_TOPIC = ethers.id("Swap(address,uint256,uint256,uint256,uint256,address)");
const ROUTER_ADDRESSES = [
  // Common DEX routers; add/remove as needed
  "0xE592427A0AEce92De3Edee1F18E0157C05861564", // Uniswap V3
  "0x10ED43C718714eb63d5aA57B78B54704E256024E", // PancakeSwap
  "0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45"  // Uniswap V2 router02
].map(a => a.toLowerCase());

console.log("🔍 Watching CA:", TOKEN_CA);
console.log("Bot is running...");

provider.on("block", async (blockNum) => {
  try {
    const block = await provider.getBlockWithTransactions(blockNum);

    for (const tx of block.transactions) {
      const toAddr = tx.to ? tx.to.toLowerCase() : "";

      // --- Detect buys / swaps ---
      if (ROUTER_ADDRESSES.includes(toAddr)) {
        const inputData = tx.data;
        if (inputData.includes(TOKEN_CA.slice(2))) {
          const msg = `💱 Swap involving token detected!\nTx: https://etherscan.io/tx/${tx.hash}`;
          await bot.telegram.sendMessage(TELEGRAM_CHAT_ID, msg);
          console.log(msg);
        }
      }

      // --- Detect direct transfers ---
      if (toAddr === TOKEN_CA) {
        const receipt = await provider.getTransactionReceipt(tx.hash);
        for (const log of receipt.logs) {
          if (log.topics[0] === TRANSFER_TOPIC && log.address.toLowerCase() === TOKEN_CA) {
            const from = "0x" + log.topics[1].slice(26);
            const to = "0x" + log.topics[2].slice(26);
            const amount = ethers.formatUnits(log.data, 18);
            const msg = `📤 Transfer\nFrom: ${from}\nTo: ${to}\nAmount: ${amount}\nTx: https://etherscan.io/tx/${tx.hash}`;
            await bot.telegram.sendMessage(TELEGRAM_CHAT_ID, msg);
            console.log(msg);
          }
        }
      }
    }
  } catch (err) {
    console.error("Block error:", err.message);
  }
});

provider._websocket.on("close", (code) => {
  console.log("🔌 WS closed:", code);
  process.exit(0);
});
